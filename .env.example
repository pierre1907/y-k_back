# Copy this file to .env and fill in your values
# Never commit .env to version control

SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:postgresql://localhost:5432/yk_db
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT — generate a random 256-bit key for production
JWT_SECRET=change-me-in-production-min-256-bits-secret-key
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server
PORT=8080

# App
APP_BASE_URL=http://localhost:3000

# Mail — dev: use MailHog (localhost:1025), staging/prod: real SMTP
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@yk-platform.com
MAIL_FROM_NAME=Y&K Platform
